{
  "name": "@appguard/expo",
  "version": "0.0.0-experimental.1",
  "description": "Experimental AppGuard native client bridge (Expo SDK 58)",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "license": "Apache-2.0",
  "author": "AppGuard contributors",
  "homepage": "https://github.com/bonjin-app/appguard",
  "files": [
    "build",
    "src",
    "android",
    "AppGuardApple.podspec",
    "ios",
    "vendor",
    "expo-module.config.json",
    "app.plugin.cjs",
    "README.md",
    "BRIDGE_CONTRACT.md",
    "VERIFICATION.md",
    "LICENSE",
    "PROVENANCE.json",
    "RISK_BRIDGE_VERIFICATION.md"
  ],
  "scripts": {
    "build": "npm run verify:backports && tsc -p tsconfig.json",
    "typecheck": "npm run verify:backports && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.cjs",
    "stage:native": "node scripts/stage-native.mjs",
    "prepack": "npm run verify:backports && npm run stage:native && tsc -p tsconfig.json",
    "verify:pack": "node scripts/verify-pack.mjs",
    "verify:backports": "node ../../scripts/dependencies/verify-backports.cjs"
  },
  "peerDependencies": {
    "expo": "^58.0.0",
    "react": "19.3.0",
    "react-native": "0.88.x"
  },
  "devDependencies": {
    "expo": "58.0.16",
    "expo-modules-core": "58.0.23",
    "@expo/config-plugins": "58.0.10",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "typescript": "6.0.3",
    "@types/react": "19.3.0",
    "braces": "file:../../tools/dependency-backports/archives/appguard-braces-3.0.3-appguard.1.tgz",
    "node-forge": "file:../../tools/dependency-backports/archives/appguard-node-forge-1.4.0-appguard.1.tgz"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true,
  "overrides": {
    "braces": "$braces",
    "node-forge": "$node-forge"
  }
}
