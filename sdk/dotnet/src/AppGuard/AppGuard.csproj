<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>AppGuard.Experimental</PackageId>
    <Version>0.0.0-experimental.1</Version>
    <Authors>UULab</Authors>
    <Description>Experimental strict AppGuard v0 verifier, policy and ASP.NET Core middleware.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/bonjin-app/appguard</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
