FROM maven:3.9.16-eclipse-temurin-17@sha256:1a352420f7aba21f5ad08df31bab55f74c013fb491f1ae8ab1dd7ff9ed698584 AS build
WORKDIR /src
COPY sdk/spring-boot/ sdk/spring-boot/
COPY examples/spring-ingress/backend/ examples/spring-ingress/backend/
RUN mvn -B -ntp -Dmaven.test.skip=true -f sdk/spring-boot/pom.xml package \
    && mvn -B -ntp org.apache.maven.plugins:maven-install-plugin:3.1.4:install-file \
       -Dfile=/src/sdk/spring-boot/target/appguard-spring-boot-starter-0.1.0-SNAPSHOT.jar \
       -DpomFile=/src/sdk/spring-boot/pom.xml \
    && mvn -B -ntp -Dmaven.test.skip=true -f examples/spring-ingress/backend/pom.xml \
       package org.apache.maven.plugins:maven-dependency-plugin:3.8.1:copy-dependencies \
       -DincludeScope=runtime -DoutputDirectory=/opt/appguard/lib

FROM eclipse-temurin:17.0.20.1_1-jre-resolute@sha256:aa78671e02c465ed264807a33fb2b2edc9fd853d05237de270e468cf84c7b412
WORKDIR /opt/appguard
COPY --from=build /src/examples/spring-ingress/backend/target/spring-ingress-backend-0.1.0-SNAPSHOT.jar /opt/appguard/backend.jar
COPY --from=build /opt/appguard/lib/ /opt/appguard/lib/
COPY deploy/spring-ingress/backend-entrypoint.sh /opt/appguard/backend-entrypoint.sh
COPY LICENSE /usr/share/licenses/appguard/LICENSE
ENV JAVA_TOOL_OPTIONS="-Xms32m -Xmx256m -XX:ActiveProcessorCount=2 -XX:+ExitOnOutOfMemoryError -Djava.io.tmpdir=/tmp"
USER 10001:10001
ENTRYPOINT ["/bin/sh", "/opt/appguard/backend-entrypoint.sh"]
