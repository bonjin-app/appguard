FROM python:3.11.17-slim-trixie@sha256:cce12316475d7d56d605f76e1d811d0dc4e7227f2d4afd29951521264f504ff8 AS build
WORKDIR /opt/appguard
COPY deploy/spring-ingress/uv.requirements.txt /tmp/uv.requirements.txt
RUN python -m pip install --no-cache-dir --disable-pip-version-check --no-deps --require-hashes -r /tmp/uv.requirements.txt
COPY sdk/python/ ./
RUN UV_LINK_MODE=copy uv sync --locked --no-dev --extra server --extra redis --no-install-project --python /usr/local/bin/python
RUN .venv/bin/python -I -c 'import importlib.metadata as m,json; from pathlib import Path; pairs=[(d.metadata["Name"].lower().replace("_","-"),d.version) for d in m.distributions()]; inventory=dict(pairs); assert len(inventory)==len(pairs); Path("runtime-inventory.json").write_text(json.dumps(inventory,sort_keys=True))'

FROM python:3.11.17-slim-trixie@sha256:cce12316475d7d56d605f76e1d811d0dc4e7227f2d4afd29951521264f504ff8
RUN PYTHONDONTWRITEBYTECODE=1 /usr/local/bin/python -m pip uninstall --yes setuptools wheel pip \
    && rm -rf /usr/local/lib/python3.11/ensurepip \
    && /usr/local/bin/python -I -c 'import importlib.util; assert all(importlib.util.find_spec(name) is None for name in ("pip","setuptools","wheel","ensurepip"))'
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/appguard/src PATH=/opt/appguard/.venv/bin:$PATH
WORKDIR /opt/appguard
COPY --from=build /opt/appguard/.venv /opt/appguard/.venv
COPY --from=build /opt/appguard/runtime-inventory.json /opt/appguard/runtime-inventory.json
RUN /opt/appguard/.venv/bin/python -I -c 'import cryptography,h11,uvicorn,redis; import importlib.metadata as m,json; from pathlib import Path; pairs=[(d.metadata["Name"].lower().replace("_","-"),d.version) for d in m.distributions()]; actual=dict(pairs); assert len(actual)==len(pairs) and actual==json.loads(Path("runtime-inventory.json").read_text()); assert {name:m.version(name) for name in ("cryptography","h11","uvicorn","redis")}=={"cryptography":"50.0.2","h11":"0.16.0","uvicorn":"0.54.0","redis":"8.1.0"}'
COPY sdk/python/src/ /opt/appguard/src/
COPY examples/spring-ingress/ingress.py /opt/appguard/ingress.py
COPY deploy/spring-ingress/probe.py /opt/appguard/probe.py
COPY LICENSE /usr/share/licenses/appguard/LICENSE
USER 10001:10001
ENTRYPOINT ["/opt/appguard/.venv/bin/python", "/opt/appguard/ingress.py"]
